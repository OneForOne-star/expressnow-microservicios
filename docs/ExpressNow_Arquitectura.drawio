" parent="1"><mxGeometry x="1305" y="760" width="24" height="24" as="geometry"/></mxCell><mxCell id="c237" value="Flujos de datos críticos (numerados en el diagrama)" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;strokeColor=#263238;fillColor=#FFFFFF;dashed=0;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="15" y="1250" width="600" height="330" as="geometry"/></mxCell><mxCell id="c238" value="&lt;b style='color:#1565C0'&gt;Flujo A · Solicitud de retiro&lt;/b&gt;&lt;br&gt;A1 Cliente envía POST /api/envios por HTTPS → A2 WAF filtra y ALB termina TLS → A3 Gateway valida JWT y rol CLIENTE → A4 ms-envios valida y guarda en envios_db → A5 persistencia en RDS → A6 ms-envios pide transportista a ms-transportistas (Circuit Breaker).&lt;br&gt;&lt;br&gt;&lt;b style='color:#EF6C00'&gt;Flujo B · Cambio de estado y notificación&lt;/b&gt;&lt;br&gt;B1 Transportista marca &quot;En ruta&quot; / &quot;Entregado&quot; → B2 Gateway enruta a ms-seguimiento (rol TRANSPORTISTA) → B3 guarda en seguimiento_db y actualiza Redis → B4 publica EstadoActualizado en SNS → B5 SNS replica el evento a cola-estado-envios (ms-envios actualiza historial) y B6 cola-notificaciones → B7 Lambda arma el mensaje → B8 SNS envía Email/SMS al cliente.&lt;br&gt;&lt;br&gt;&lt;b style='color:#2E7D32'&gt;Flujo C · Consulta de seguimiento (lectura intensiva)&lt;/b&gt;&lt;br&gt;C1 Cliente consulta GET /api/seguimiento/{codigo} → C2 ms-seguimiento → C3 lee Redis primero y solo va a RDS si no está en caché." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1A1A1A;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1280" width="575" height="300" as="geometry"/></mxCell><mxCell id="c239" value="Patrones de diseño aplicados y su aporte" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;strokeColor=#263238;fillColor=#FFFFFF;dashed=0;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="630" y="1250" width="640" height="330" as="geometry"/></mxCell><mxCell id="c240" value="&lt;b&gt;API Gateway&lt;/b&gt; – entrada única; centraliza autenticación, autorización y rate limiting (&lt;i&gt;seguridad, mantenibilidad&lt;/i&gt;).&lt;br&gt;&lt;b&gt;Service Registry (Eureka)&lt;/b&gt; – las instancias se registran solas; el Gateway balancea entre ellas (&lt;i&gt;escalabilidad, disponibilidad&lt;/i&gt;).&lt;br&gt;&lt;b&gt;Circuit Breaker (Resilience4j)&lt;/b&gt; – si ms-transportistas o Google Maps fallan, se responde con fallback en vez de propagar el error (&lt;i&gt;disponibilidad&lt;/i&gt;).&lt;br&gt;&lt;b&gt;Database per Service&lt;/b&gt; – cada servicio es dueño de su esquema; cambios sin afectar a otros (&lt;i&gt;mantenibilidad, bajo acoplamiento&lt;/i&gt;).&lt;br&gt;&lt;b&gt;Publish/Subscribe + colas (SNS → SQS)&lt;/b&gt; – los servicios no se llaman entre sí para notificar; absorbe peaks (&lt;i&gt;escalabilidad, desacoplamiento&lt;/i&gt;).&lt;br&gt;&lt;b&gt;Dead Letter Queue&lt;/b&gt; – ningún mensaje se pierde (&lt;i&gt;disponibilidad&lt;/i&gt;).&lt;br&gt;&lt;b&gt;Cache-aside (Redis)&lt;/b&gt; – alivia el cuello de botella de lecturas de tracking (&lt;i&gt;rendimiento&lt;/i&gt;).&lt;br&gt;&lt;b&gt;Externalized Configuration&lt;/b&gt; – misma imagen Docker para dev y prod (&lt;i&gt;mantenibilidad&lt;/i&gt;)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1A1A1A;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="645" y="1280" width="615" height="300" as="geometry"/></mxCell><mxCell id="c241" value="Leyenda" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;strokeColor=#263238;fillColor=#FFFFFF;dashed=0;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1285" y="1250" width="995" height="330" as="geometry"/></mxCell><mxCell id="c242" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1300" y="1285" width="1" height="1" as="geometry"/></mxCell><mxCell id="c243" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1380" y="1285" width="1" height="1" as="geometry"/></mxCell><mxCell id="c244" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;endArrow=block;endFill=1;strokeColor=#37474F;strokeWidth=1.5;" edge="1" parent="1" source="c242" target="c243"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c245" value="Llamada síncrona REST/HTTP (JSON)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1A1A1A;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1390" y="1276" width="260" height="20" as="geometry"/></mxCell><mxCell id="c246" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1300" y="1311" width="1" height="1" as="geometry"/></mxCell><mxCell id="c247" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1380" y="1311" width="1" height="1" as="geometry"/></mxCell><mxCell id="c248" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;endArrow=open;endFill=0;strokeColor=#AD1457;strokeWidth=1.8;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="c246" target="c247"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c249" value="Evento / mensaje asíncrono (SNS, SQS)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1A1A1A;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1390" y="1302" width="260" height="20" as="geometry"/></mxCell><mxCell id="c250" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1300" y="1337" width="1" height="1" as="geometry"/></mxCell><mxCell id="c251" value="" 