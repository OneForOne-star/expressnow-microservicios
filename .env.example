# Copia este archivo como .env (no se sube a git) o exporta las variables
# en tu terminal antes de ejecutar cada microservicio contra Amazon RDS.

# Endpoint de la instancia RDS (Consola AWS > RDS > Bases de datos > Conectividad)
DB_HOST=expressnow-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
# RDS soporta TLS: exige conexión cifrada
DB_SSL_MODE=REQUIRED

# Credenciales: cada microservicio usa su propio usuario (ver database/01_esquemas_y_usuarios.sql)
# DB_USER=ms_usuarios
# DB_PASSWORD=********
